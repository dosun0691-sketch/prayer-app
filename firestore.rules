rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Member list: everyone reads; nobody writes from the app (pastor changes it via Jarvis / Firebase console).
    match /config/group {
      allow read: if true;
      allow write: if false;
    }
    // One record per (date, member). Anyone with the link may record; only well-formed records are accepted.
    match /entries/{id} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['date', 'member', 'minutes'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.member is string
        && request.resource.data.member.matches('^m[0-9]{1,3}$')
        && id == request.resource.data.date + '_' + request.resource.data.member
        && request.resource.data.minutes is int
        && request.resource.data.minutes >= 0 && request.resource.data.minutes <= 1440;
    }
    match /{other=**} { allow read, write: if false; }
  }
}
