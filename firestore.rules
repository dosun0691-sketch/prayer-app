rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Members register with a name and three goals (Mon-Fri / Sat / Sun). Re-registering the same name
    // (e.g. after reinstalling the app) may change the goals only — the name never changes, nothing is deleted.
    function goalOk(v) { return v is int && v >= 10 && v <= 600; }
    function goalsOk(d) {
      return goalOk(d.goal)
        && (!('goalSat' in d) || goalOk(d.goalSat))
        && (!('goalSun' in d) || goalOk(d.goalSun));
    }
    // Leaving (owner order 2026-11-16): a member is never deleted; "left: true" (+ leftAt) hides them, records stay.
    // "joined" = registration day (prayer-day key) so a new member is not hidden by the 14-day inactivity rule.
    function dateOk(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function extrasOk(d) {
      return (!('joined' in d) || dateOk(d.joined))
        && (!('leftAt' in d) || dateOk(d.leftAt))
        && (!('left' in d) || d.left is bool);
    }
    match /members/{mid} {
      allow read: if true;
      allow delete: if false;
      allow create: if mid.matches('^[A-Za-z0-9]{8,32}$')
        && request.resource.data.keys().hasOnly(['name', 'goal', 'goalSat', 'goalSun', 'joined', 'left'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
        && goalsOk(request.resource.data) && extrasOk(request.resource.data);
      allow update: if request.resource.data.keys().hasOnly(['name', 'goal', 'goalSat', 'goalSun', 'joined', 'left', 'leftAt'])
        && request.resource.data.name == resource.data.name
        && goalsOk(request.resource.data) && extrasOk(request.resource.data);
    }
    // One record per (date, member). Only well-formed records for a registered member are accepted.
    match /entries/{id} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['date', 'member', 'minutes'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.member is string
        && exists(/databases/$(db)/documents/members/$(request.resource.data.member))
        && id == request.resource.data.date + '_' + request.resource.data.member
        && request.resource.data.minutes is int
        && request.resource.data.minutes >= 0 && request.resource.data.minutes <= 1440;
    }
    match /{other=**} { allow read, write: if false; }
  }
}
