rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Members register themselves once (name + daily goal). No edits/deletes from the app — the pastor asks Jarvis.
    match /members/{mid} {
      allow read: if true;
      allow update, delete: if false;
      allow create: if mid.matches('^[A-Za-z0-9]{8,32}$')
        && request.resource.data.keys().hasOnly(['name', 'goal'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
        && request.resource.data.goal is int
        && request.resource.data.goal >= 10 && request.resource.data.goal <= 600;
    }
    // One record per (date, member). Only well-formed records for a registered member are accepted.
    match /entries/{id} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['date', 'member', 'minutes'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.member is string
        && exists(/databases/$(db)/documents/members/$(request.resource.data.member))
        && id == request.resource.data.date + '_' + request.resource.data.member
        && request.resource.data.minutes is int
        && request.resource.data.minutes >= 0 && request.resource.data.minutes <= 1440;
    }
    match /{other=**} { allow read, write: if false; }
  }
}
